        <mxCell id="FSuldy_ZDpSkRawvRfAq-53" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Invariantes&lt;/h1&gt;&lt;div&gt;&lt;div&gt;Invariante de Estado de Conductor: Un Conductor no puede ser asignado a un nuevo Viaje si su atributo estado es diferente de &quot;Disponible&quot;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Invariante de Calificación: El valor de la propiedad calificacion en Usuario o Conductor debe ser estrictamente un decimal entre 1.0 y 5.0.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Invariante de Cobro: El valor total de Factura.montoTotal debe ser siempre estrictamente mayor a 0 y mayor o igual a Viaje.tarifaBase.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="550" x="710" y="650" as="geometry" />
        </mxCell>
